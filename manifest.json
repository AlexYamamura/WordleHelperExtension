{
    "manifest_version": 3,
    "name": "Wordle Helper",
    "version": "1.2",
    "description": "Analyze current Wordle options and provide possible word list. This extension currently only works on the official NY Times Wordle website.",
    "icons" : {
        "16": "images/wordle-icon-16.png",
        "32": "images/wordle-icon-32.png",
        "48": "images/wordle-icon-48.png",
        "128": "images/wordle-icon-128.png"
    },
    "content_scripts": [
        {
        "js": ["scripts/jquery-3.7.1.min.js", "scripts/content.js"],
        "matches": [
            "https://*.nytimes.com/games/wordle/*"
        ]
        }
    ],
    "action": {
        "default_icon": "images/wordle-icon-128.png",
        "default_popup": "html/popup.html"
    },
    "background": {
        "service_worker": "services/service_worker.js",
        "type": "module"
    },
    "permissions": [
        "sidePanel",
        "tabs",
        "storage"
    ],
    "web_accessible_resources": [
        {
            "resources": ["resources/*"],
            "matches": ["<all_urls>"]
        }
    ]
}